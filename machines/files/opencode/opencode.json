{
	"$schema": "https://opencode.ai/config.json",
	"experimental": {
		"background_compaction": true,
		"subagent_depth": 3,
		"todo": true
	},
	"lsp": true,
	"mcp": {
		"servers": {
			"codebase-memory-mcp": {
				"command": ["~/.local/bin/codebase-memory-mcp"],
				"type": "local"
			},
			"context7": {
				"command": [
					"context7-mcp",
					"--api-key",
					"$$OPENCODE_CONTEXT7_API_KEY$$"
				],
				"type": "local"
			},
			"GitHits": {
				"command": ["githits", "mcp", "start"],
				"type": "local"
			}
		}
	},
	"permissions": [
		{
			"action": "external_directory",
			"effect": "allow",
			"resource": "~/.agents/*"
		},
		{
			"action": "external_directory",
			"effect": "allow",
			"resource": "/tmp/*"
		}
	],
	"plugins": ["@dietrichgebert/ponytail"],
	"share": "disabled",
	"update": "auto"
}
