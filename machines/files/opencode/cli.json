{
	"$schema": "https://opencode.ai/v2/cli.json",
	"animations": true,
	"attention": {
		"notifications": true,
		"sound": true,
		"sound_pack": "opencode.default",
		"volume": 0.7
	},
	"diffs": {
		"wrap": "word"
	},
	"keybinds": {
		"command.palette.show": ["ctrl+k", "ctrl+p"]
	},
	"scroll": {
		"acceleration": true
	},
	"session": {
		"markdown": "rendered",
		"scrollbar": false,
		"sidebar": "auto",
		"thinking": "show"
	},
	"theme": {
		"mode": "system",
		"name": "vercel"
	}
}
