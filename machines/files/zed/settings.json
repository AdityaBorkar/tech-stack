		"Svelte": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TSX": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"language_servers": ["tsgo"]
		},
		"Vue.js": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		}
	},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		}
	},
	"minimap": {
		"show": "always"
	},
	"outline_panel": {
		"dock": "right"
	},
	"preview_tabs": {
		"enable_preview_from_file_finder": true
	},
	"project_panel": {
		"bold_folder_labels": false,
		"diagnostic_badges": true,
		"dock": "left",
		"git_status_indicator": false,
		"hide_root": true
	},
	"proxy": "",
	"relative_line_numbers": "disabled",
	"search": {
		"center_on_match": true
	},
	"semantic_tokens": "off",
	"show_edit_predictions": true,
	"status_bar": {
		"show_active_file": false
	},
	"sticky_scroll": {
		"enabled": true
	},
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": false,
		"show_tab_bar_buttons": false
	},
	"tabs": {
		"file_icons": false,
		"git_status": true,
		"show_diagnostics": "all"
	},
	"telemetry": {
		"diagnostics": true,
		"metrics": true
	},
	"terminal": {
		"font_family": "Fira Code",
		"font_features": {
			"calt": true,
			"liga": true
		},
		"show_count_badge": false,
		"toolbar": {
			"breadcrumbs": false
		}
	},
	"text_rendering_mode": "platform_default",
	"theme": {
		"dark": "Vercel Dark",
		"light": "One Light",
		"mode": "dark"
	},
	"title_bar": {
		"show_branch_status_icon": true,
		"show_menus": false
	},
	"toolbar": {
		"code_actions": true
	},
	"ui_font_family": ".ZedSans",
	"ui_font_size": 12.0,
	"ui_font_weight": 400.0
}
