{
	"agent": {
		"dock": "left",
		"favorite_models": [],
		"model_parameters": []
	},
	"agent_servers": {},
	"autoscroll_on_clicks": true,
	"base_keymap": "VSCode",
	"buffer_font_family": "Fira Code",
	"buffer_font_features": {
		"calt": true,
		"liga": true
	},
	"buffer_font_size": 12.0,
	"buffer_font_weight": 400.0,
	"cli_default_open_behavior": "existing_window",
	"collaboration_panel": {
		"dock": "right"
	},
	"colorize_brackets": false,
	"cursor_shape": "bar",
	"diagnostics": {
		"inline": {
			"enabled": true
		}
	},
	"edit_predictions": {
		"provider": "zed"
	},
	"file_types": {},
	"git": {
		"gutter_debounce": 100,
		"inline_blame": {
			"delay_ms": 200,
			"show_commit_summary": true
		}
	},
	"git_panel": {
		"collapse_untracked_diff": false,
		"diff_stats": true,
		"dock": "right",
		"file_icons": false,
		"folder_icons": true,
		"show_count_badge": false,
		"tree_view": false
	},
	"icon_theme": "Symbols Icon Theme",
	"inlay_hints": {
		"enabled": true
	},
	"languages": {
		"Astro": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"CSS": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"GraphQL": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"HTML": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JavaScript": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSON": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSONC": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSX": {
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"Markdown": {
			"formatter": {
				"language_server": {
					"name": "markdownlint"
				}
			}
