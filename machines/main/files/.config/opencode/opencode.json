{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"plugins": ["@dietrichgebert/ponytail"],
	"mcp": {
		"servers": {
			"context7": {
				"type": "local",
				"command": ["context7-mcp", "--api-key", "@@OPENCODE_CONTEXT7_API_KEY@@"]
			},
			"GitHits": {
				"type": "local",
				"command": ["githits", "mcp", "start"]
			},
			"codebase-memory-mcp": {
				"command": ["~/.local/bin/codebase-memory-mcp"],
				"type": "local"
			}
		}
	},
	"update": "auto",
	"share": "disabled",
	"permissions": [
		{
			"action": "external_directory",
			"resource": "~/.agents/*",
			"effect": "allow"
		},
		{
			"action": "external_directory",
			"resource": "/tmp/*",
			"effect": "allow"
		}
	],
	"experimental": {
		"todo": true,
		"subagent_depth": 3,
		"background_compaction": true
	}
}
