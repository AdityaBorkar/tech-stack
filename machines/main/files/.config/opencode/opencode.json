{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "context7-mcp",
                "--api-key",
                "@@OPENCODE_CONTEXT7_API_KEY@@"
            ],
            "enabled": true
        },
        "GitHits": {
            "type": "local",
            "command": [
                "githits",
                "mcp",
                "start"
            ],
            "enabled": true
        },
        "codebase-memory-mcp": {
            "command": [
                "/home/aditya/.local/bin/codebase-memory-mcp"
            ],
            "type": "local",
            "enabled": true
        },
        "codedb": {
            "type": "local",
            "command": [
                "codedb",
                "mcp"
            ],
            "enabled": false
        },
        "expect": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "expect-cli@latest",
                "mcp"
            ],
            "enabled": false
        }
    },
    "autoupdate": true,
    "share": "disabled",
    "username": "adityaborkar",
    "permissions": [
        {
            "action": "external_directory",
            "resource": "~/.agents/*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/*",
            "effect": "allow"
        }
    ]
}
