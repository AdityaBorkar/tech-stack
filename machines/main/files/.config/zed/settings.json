// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"proxy": "",
	"preview_tabs": {
		"enable_preview_from_file_finder": true
	},
	"tab_bar": {
		"show_tab_bar_buttons": false,
		"show_pinned_tabs_in_separate_row": false
	},
	"tabs": {
		"show_diagnostics": "all",
		"file_icons": false,
		"git_status": true
	},
	"title_bar": {
		"show_menus": false,
		"show_branch_status_icon": true
	},
	"status_bar": {
		"show_active_file": false
	},
	"search": {
		"center_on_match": true
	},
	"semantic_tokens": "off",
	"colorize_brackets": false,
	"inlay_hints": {
		"enabled": true
	},
	"toolbar": {
		"code_actions": true
	},
	"relative_line_numbers": "disabled",
	"autoscroll_on_clicks": true,
	"sticky_scroll": {
		"enabled": true
	},
	"cursor_shape": "bar",
	"text_rendering_mode": "platform_default",
	"buffer_font_weight": 400.0,
	"diagnostics": {
		"inline": {
			"enabled": true
		}
	},
	"git": {
		"gutter_debounce": 100,
		"inline_blame": {
			"show_commit_summary": true,
			"delay_ms": 200
		}
	},
	"cli_default_open_behavior": "existing_window",
	"wsl_connections": [
		{
			"distro_name": "Ubuntu-24.04",
			"user": null,
			"projects": []
		}
	],
	"project_panel": {
		"hide_root": true,
		"git_status_indicator": false,
		"diagnostic_badges": true,
		"bold_folder_labels": false,
		"dock": "left"
	},
	"outline_panel": {
		"dock": "right"
	},
	"collaboration_panel": {
		"dock": "right"
	},
	"agent": {
		"dock": "left",
		"favorite_models": [],
		"model_parameters": []
	},
	"git_panel": {
		"show_count_badge": false,
		"diff_stats": true,
		"collapse_untracked_diff": false,
		"folder_icons": true,
		"file_icons": false,
		"tree_view": false,
		"dock": "right"
	},
	"agent_servers": {
		"opencode": {
			"type": "registry"
		},
		"factory-droid": {
			"type": "registry"
		},
		"claude-acp": {
			"type": "registry"
		}
	},
	"edit_predictions": {
		"provider": "zed"
	},
	"ui_font_weight": 400.0,
	"ui_font_family": ".ZedSans",
	"buffer_font_family": "Fira Code",
	"buffer_font_features": {
		"calt": true,
		"liga": true
	},
	"terminal": {
		"toolbar": {
			"breadcrumbs": false
		},
		"show_count_badge": false,
		"font_family": "Fira Code",
		"font_features": {
			"calt": true,
			"liga": true
		}
	},
	"telemetry": {
		"diagnostics": true,
		"metrics": true
	},
	"minimap": {
		"show": "always"
	},
	"file_types": {},
	"show_edit_predictions": true,
	"base_keymap": "VSCode",
	"icon_theme": "Symbols Icon Theme",
	"ui_font_size": 12.0,
	"buffer_font_size": 12.0,
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Vercel Dark"
	},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		}
	},
	"languages": {
		"Astro": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"CSS": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"GraphQL": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"HTML": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSONC": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSX": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JavaScript": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"language_servers": ["tsgo"],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"Svelte": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"Vue.js": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"Markdown": {
			"formatter": {
				"language_server": {
					"name": "markdownlint"
				}
			}
		}
	}
}
