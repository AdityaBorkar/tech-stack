			"net-tools": "latest",
			"nodejs": "latest",
			"patch": "latest",
			"pkgconf": "latest",
			"postgresql-libs": "latest",
			"python": "latest",
			"ripgrep": "latest",
			"socat": "latest",
			"sqlite": "latest",
			"strace": "latest",
