{
	"$description": "Primary Developer Machine",
	"$name": "Primary Developer Machine",
	"$schema": "../node_modules/@adistack/conform/config/machine-manifest.json",
	"allowlist": {
		"pacman": ["base", "base-devel", "linux", "linux-firmware", "sudo"]
	},
	"files": [
		{
			"name": "Bash RC",
			"source": "machines/files/bashrc",
			"target": "~/.bashrc"
		},
		{
			"name": "Profile",
			"source": "machines/files/profile",
			"target": "~/.profile"
		},
		{
			"name": "Bash Logout",
			"source": "machines/files/bash_logout",
			"target": "~/.bash_logout"
		},
		{
			"name": "Zsh RC",
			"source": "machines/files/zshrc",
			"target": "~/.zshrc"
		},
		{
			"name": "AWS Config",
			"source": "machines/files/aws/config",
			"target": "~/.aws/config"
		},
		{
			"name": "Docker Config",
			"source": "machines/files/docker/config.json",
			"target": "~/.docker/config.json"
		},
		{
			"name": "Git Config",
			"source": "machines/files/git/config",
			"target": "~/.gitconfig"
		},
		{
			"name": "GitHub Config",
			"source": "machines/files/gh/config.yml",
			"target": "~/.config/gh/config.yml"
		},
		{
			"name": "SSH Known Hosts",
			"source": "machines/files/ssh/known_hosts",
			"target": "~/.ssh/known_hosts"
		},
		{
			"name": "SSH Config",
			"source": "machines/files/ssh/config",
			"target": "~/.ssh/config"
		},
		{
			"name": "OpenCode Agents",
			"source": "machines/files/opencode/AGENTS.md",
			"target": "~/.config/opencode/AGENTS.md"
		},
		{
			"name": "Codebase Memory",
			"source": "machines/files/opencode/agents/codebase-memory.md",
			"target": "~/.config/opencode/agents/codebase-memory.md"
		},
		{
			"name": "Codebase Memory Auditor",
			"source": "machines/files/opencode/agents/codebase-memory-auditor.md",
			"target": "~/.config/opencode/agents/codebase-memory-auditor.md"
		},
		{
			"name": "Codebase Memory Scout",
			"source": "machines/files/opencode/agents/codebase-memory-scout.md",
			"target": "~/.config/opencode/agents/codebase-memory-scout.md"
		},
		{
			"name": "OpenCode CLI",
			"source": "machines/files/opencode/cli.json",
			"target": "~/.config/opencode/cli.json"
		},
		{
			"name": "OpenCode Package",
			"source": "machines/files/opencode/package.json",
			"target": "~/.config/opencode/package.json"
		},
		{
			"name": "CBM Augment",
			"source": "machines/files/opencode/plugins/cbm-augment.ts",
			"target": "~/.config/opencode/plugins/cbm-augment.ts"
		},
		{
			"name": "RTK",
			"source": "machines/files/opencode/plugins/rtk.ts",
			"target": "~/.config/opencode/plugins/rtk.ts"
		},
		{
			"name": "Codebase Memory Skill",
			"source": "machines/files/opencode/skills/codebase-memory/SKILL.md",
			"target": "~/.config/opencode/skills/codebase-memory/SKILL.md"
		},
		{
			"name": "VS Code Settings",
			"source": "machines/files/vscode/settings.json",
			"target": "~/.config/Code/User/settings.json"
		},
		{
			"name": "Zed Settings",
			"source": "machines/files/zed/settings.json",
			"target": "~/.config/zed/settings.json"
		},
		{
			"name": "Claude Settings",
			"source": "machines/files/.claude/settings.json",
			"target": "~/.claude/settings.json"
		},
		{
			"mode": "0600",
			"name": "AWS Credentials",
			"secrets": [
				"AWS_PROD_ACCESS_KEY_ID",
				"AWS_PROD_SECRET_ACCESS_KEY",
				"AWS_DEV_ACCESS_KEY_ID",
				"AWS_DEV_SECRET_ACCESS_KEY"
			],
			"source": "machines/files/aws/credentials",
			"target": "~/.aws/credentials"
		},
		{
			"mode": "0600",
			"name": "GitHub Hosts",
			"secrets": ["GH_OAUTH_TOKEN"],
			"source": "machines/files/gh/hosts.yml",
			"target": "~/.config/gh/hosts.yml"
		},
		{
			"mode": "0600",
			"name": "NPM RC",
			"secrets": ["NPM_AUTH_TOKEN"],
			"source": "machines/files/npmrc",
			"target": "~/.npmrc"
		},
		{
			"name": "EAS Settings",
			"secrets": ["EAS_ANALYTICS_DEVICE_ID"],
			"source": "machines/files/eas-cli/user-settings.json",
			"target": "~/.config/eas-cli-nodejs/user-settings.json"
		},
		{
			"name": "OpenCode Config",
			"secrets": ["OPENCODE_CONTEXT7_API_KEY"],
			"source": "machines/files/opencode/opencode.json",
			"target": "~/.config/opencode/opencode.json"
		},
		{
			"name": "WakaTime Config",
			"secrets": ["WAKATIME_API_KEY"],
			"source": "machines/files/wakatime.cfg",
			"target": "~/.wakatime.cfg"
		}
	],
	"packages": {
		"apt": {
			"acl": "latest",
			"autoconf": "latest",
			"automake": "latest",
			"binutils": "latest",
			"btop": "latest",
			"caddy": "latest",
			"cloudflared": "latest",
			"cockpit": "latest",
			"curl": "latest",
			"direnv": "latest",
			"dnsmasq": "latest",
			"docker.io": "latest",
			"fd-find": "latest",
			"ffmpeg": "latest",
			"file": "latest",
			"gcc": "latest",
			"gh": "latest",
			"git": "latest",
			"gnome-keyring": "latest",
			"golang-go": "latest",
			"google-chrome-stable": "latest",
			"gradle": "latest",
			"hyperfine": "latest",
			"iptables": "latest",
			"jq": "latest",
			"libtool": "latest",
			"lsof": "latest",
			"make": "latest",
			"mkcert": "latest",
			"nano": "latest",
			"ncdu": "latest",
			"net-tools": "latest",
			"nodejs": "latest",
			"openjdk-17-jdk": "latest",
			"patch": "latest",
			"pkgconf": "latest",
			"postgresql-client": "latest",
			"python3": "latest",
			"ripgrep": "latest",
			"socat": "latest",
			"sqlite3": "latest",
			"strace": "latest",
			"tree": "latest",
			"unzip": "latest",
			"wget": "latest",
			"xvfb": "latest",
			"zsh": "latest",
			"zsh-autosuggestions": "latest",
			"zsh-syntax-highlighting": "latest"
		},
		"bun": {
			"@earendil-works/pi-coding-agent": "latest",
			"@oh-my-pi/pi-coding-agent": "latest",
			"@oh-my-pi/pi-natives": "latest",
			"@oh-my-pi/pi-natives-linux-x64": "latest",
			"@opencode/browse": "latest",
			"@opencode/cli": "latest",
			"@upstash/context7-mcp": "latest",
			"cf": "latest",
			"eas-cli": "latest",
			"expect-cli": "latest",
