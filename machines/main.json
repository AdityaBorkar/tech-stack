			"hyperfine": "latest",
			"iptables": "latest",
			"jdk17-openjdk": "latest",
			"jq": "latest",
			"libtool": "latest",
			"lsof": "latest",
			"make": "latest",
			"mkcert": "latest",
			"nano": "latest",
