{
  "$schema": "https://stack.adityab.tech/conform/<VERSION>/schemas/project-manifest.json",
  "description": "RPC Contract using oRPC + Zod",
  "file_structure": [
    {
      "name": "Source Dir",
      "target": "src/",
      "kind": "dir"
    },
    {
      "name": "AGENTS.md",
      "target": "AGENTS.md",
      "kind": "file"
    },
    {
      "name": "README.md",
      "target": "README.md",
      "kind": "file"
    }
  ],
  "files": [
    {
      "name": "Bun Config",
      "source": "../$presets/bunfig.toml",
      "target": "bunfig.toml"
    },
    {
      "name": "Commitlint Config",
      "source": "../$presets/commitlintrc-rpc.json",
      "target": ".commitlintrc.json"
    },
    {
      "name": "Gitignore",
      "source": "../$presets/gitignore-rpc",
      "target": ".gitignore"
    },
    {
      "name": "Husky Commit-Msg Hook",
      "source": "../$presets/husky-commit-msg",
      "target": ".husky/commit-msg"
    },
    {
      "name": "Husky Pre-Commit Hook",
      "source": "../$presets/husky-pre-commit",
      "target": ".husky/pre-commit"
    },
    {
      "compare": {
        "ignore": ["overrides"]
      },
      "name": "Oxfmt Config",
      "source": "../$presets/oxfmt-rpc.json",
      "target": ".oxfmtrc.json"
    },
    {
      "compare": {
        "ignore": ["overrides"]
      },
      "name": "Oxlint Config",
      "source": "../$presets/oxlint-rpc.json",
      "target": ".oxlintrc.json"
    },
    {
      "name": "TypeScript Config",
      "source": "../$presets/tsconfig-rpc.json",
      "target": "tsconfig.json"
    },
    {
      "name": "TypeScript Build Config",
      "source": "../$presets/tsconfig.build-rpc.json",
      "target": "tsconfig.build.json"
    },
    {
      "name": "Zed Settings",
      "source": "../$presets/zed-rpc.json",
      "target": ".zed/settings.json"
    },
    {
      "compare": {
        "pinned": ["scripts", "imports", "type"]
      },
      "name": "Package JSON",
      "source": "../$presets/_package.json",
      "target": "package.json"
    }
  ],
  "js": {
    "dependencies": {
      "@orpc/contract": "1.16.2",
      "zod": "4.6.7",
      "zod-compiler": "2.0.8"
    },
    "devDependencies": {
      "@commitlint/cli": "21.2.4",
      "@commitlint/config-conventional": "21.2.4",
      "@types/bun": "1.4.4",
      "husky": "9.1.7",
      "oxlint": "1.92.0",
      "typescript": "7.0.2"
    },
    "peerDependencies": {},
    "pm": "bun"
  }
}
