{
	"$schema": "https://raw.githubusercontent.com/AdityaBorkar/adistack-conform/refs/heads/main/configuration_schema/project-manifest.json",
	"description": "Website using Astro",
	"file_structure": [
		{
			"name": "Source Dir",
			"target": "src/",
			"kind": "dir"
		},
		{
			"name": "AGENTS.md",
			"target": "AGENTS.md",
			"kind": "file"
		},
		{
			"name": "README.md",
			"target": "README.md",
			"kind": "file"
		}
	],
	"files": [
		{
			"name": "Bun Config",
			"source": "projects/files/bunfig/astro.toml",
			"target": "bunfig.toml"
		},
		{
			"name": "Commitlint Config",
			"source": "projects/files/commitlintrc.json",
			"target": ".commitlintrc.json"
		},
		{
			"name": "Gitignore",
			"source": "projects/files/gitignore/astro.gitignore",
			"target": ".gitignore"
		},
		{
			"name": "Husky Commit-Msg Hook",
			"source": "projects/files/husky/commit-msg",
			"target": ".husky/commit-msg"
		},
		{
			"name": "Husky Pre-Commit Hook",
			"source": "projects/files/husky/pre-commit",
			"target": ".husky/pre-commit"
		},
		{
			"name": "Knip Config",
			"source": "projects/files/knip/astro.json",
			"target": "knip.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxfmt Config",
			"source": "projects/files/oxfmt/base.json",
			"target": ".oxfmtrc.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxlint Config",
			"source": "projects/files/oxlint/astro.json",
			"target": ".oxlintrc.json"
		},
		{
			"name": "TypeScript Config",
			"source": "projects/files/tsconfig/astro.json",
			"target": "tsconfig.json"
		},
		{
			"name": "Zed Settings",
			"source": "projects/files/zed/astro.json",
			"target": ".zed/settings.json"
		},
		{
			"name": "Astro Config",
			"source": "projects/files/astro.config.mjs",
			"target": "astro.config.mjs"
		},
		{
			"name": "Wrangler Config",
			"source": "projects/files/wrangler.json",
			"target": "wrangler.json"
		},
		{
			"name": "CSpell Config",
			"source": "projects/files/cspell.json",
			"target": "cspell.json"
		},
		{
			"name": "HTML-Validate Config",
			"source": "projects/files/htmlvalidate.json",
			"target": ".htmlvalidate.json"
		},
		{
			"name": "Pa11y CI Config",
			"source": "projects/files/pa11yci.json",
			"target": ".pa11yci.json"
		},
		{
			"name": "Vale Config",
			"source": "projects/files/vale.ini",
			"target": ".vale.ini"
		},
		{
			"name": "Unlighthouse Config",
			"source": "projects/files/unlighthouse.config.ts",
			"target": "unlighthouse.config.ts"
		},
		{
			"compare": {
				"pinned": [
					"type",
					"imports",
					"exports",
					"license",
					"files",
					"scripts",
					"author",
					"maintainers",
					"contributors"
				],
				"required": [
					"name",
					"version",
					"description",
					"keywords",
					"homepage",
					"bugs",
					"repository",
					"bin"
				]
			},
			"name": "Package JSON",
			"source": "projects/files/package/cli.json",
			"target": "package.json"
		}
	],
	"js": {
		"dependencies": {},
		"devDependencies": {
			"@commitlint/cli": "21.2.4",
			"@commitlint/config-conventional": "21.2.4",
			"@types/bun": "1.4.4",
			"@types/node": "26.6.5",
			"husky": "9.1.7",
			"knip": "6.43.0",
			"oxfmt": "0.75.0",
			"oxlint": "1.90.0",
			"rimraf": "6.1.3",
			"tsrs": "0.20.1-ts7.1.0-beta",
			"typescript": "7.0.2"
		},
		"peerDependencies": {},
		"pm": "bun"
	}
}
