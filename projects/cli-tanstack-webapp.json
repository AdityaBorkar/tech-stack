{
	"$schema": "https://raw.githubusercontent.com/AdityaBorkar/adistack-conform/refs/heads/main/configuration_schema/project-manifest.json",
	"description": "CLI + Web App using TanStack Start",
	"file_structure": [
		{
			"name": "Source Dir",
			"target": "src/",
			"kind": "dir"
		},
		{
			"name": "AGENTS.md",
			"target": "AGENTS.md",
			"kind": "file"
		},
		{
			"name": "README.md",
			"target": "README.md",
			"kind": "file"
		}
	],
	"files": [
		{
			"name": "Bun Config",
			"source": "projects/files/bunfig/base.toml",
			"target": "bunfig.toml"
		},
		{
			"name": "Commitlint Config",
			"source": "projects/files/commitlintrc.json",
			"target": ".commitlintrc.json"
		},
		{
			"name": "Gitignore",
			"source": "projects/files/gitignore/base.gitignore",
			"target": ".gitignore"
		},
		{
			"name": "Husky Commit-Msg Hook",
			"source": "projects/files/husky/commit-msg",
			"target": ".husky/commit-msg"
		},
		{
			"name": "Husky Pre-Commit Hook",
			"source": "projects/files/husky/pre-commit",
			"target": ".husky/pre-commit"
		},
		{
			"name": "Knip Config",
			"source": "projects/files/knip/cli-tanstack.json",
			"target": "knip.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxfmt Config",
			"source": "projects/files/oxfmt/base.json",
			"target": ".oxfmtrc.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxlint Config",
			"source": "projects/files/oxlint/cli-tanstack.json",
			"target": ".oxlintrc.json"
		},
		{
			"name": "TypeScript Config",
			"source": "projects/files/tsconfig/cli-tanstack.json",
			"target": "tsconfig.json"
		},
		{
			"name": "Zed Settings",
			"source": "projects/files/zed/base.json",
			"target": ".zed/settings.json"
		},
		{
			"name": "Vite Config",
			"source": "projects/files/vite.config.ts",
			"target": "vite.config.ts"
		},
		{
			"name": "TanStack Router Config",
			"source": "projects/files/tsr.config.json",
			"target": "tsr.config.json"
		},
		{
			"name": "shadcn Components Config",
			"source": "projects/files/components.json",
			"target": "components.json"
		},
		{
			"compare": {
				"pinned": [
					"type",
					"imports",
					"exports",
					"license",
					"files",
					"scripts",
					"author",
					"maintainers",
					"contributors"
				],
				"required": [
					"name",
					"version",
					"description",
					"keywords",
					"homepage",
					"bugs",
					"repository",
					"bin"
				]
			},
			"name": "Package JSON",
			"source": "projects/files/package/cli.json",
			"target": "package.json"
		}
	],
	"js": {
		"dependencies": {},
		"devDependencies": {
			"@commitlint/cli": "21.2.4",
			"@commitlint/config-conventional": "21.2.4",
			"@types/bun": "1.4.4",
			"@types/node": "26.6.5",
			"husky": "9.1.7",
			"knip": "6.43.0",
			"oxfmt": "0.75.0",
			"oxlint": "1.90.0",
			"rimraf": "6.1.3",
			"tsrs": "0.20.1-ts7.1.0-beta",
			"typescript": "7.0.2"
		},
		"peerDependencies": {},
		"pm": "bun"
	}
}
