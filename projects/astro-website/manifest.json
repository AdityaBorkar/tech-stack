{
  "$schema": "https://stack.adityab.tech/conform/<VERSION>/schemas/project-manifest.json",
  "description": "Website using Astro",
  "file_structure": [
    {
      "name": "Source Dir",
      "target": "src/",
      "kind": "dir"
    },
    {
      "name": "AGENTS.md",
      "target": "AGENTS.md",
      "kind": "file"
    },
    {
      "name": "README.md",
      "target": "README.md",
      "kind": "file"
    }
  ],
  "files": [
    {
      "name": "Bun Config",
      "source": "../$presets/bunfig-astro.toml",
      "target": "bunfig.toml"
    },
    {
      "name": "Commitlint Config",
      "source": "../$presets/commitlintrc.json",
      "target": ".commitlintrc.json"
    },
    {
      "name": "Gitignore",
      "source": "../$presets/gitignore-astro",
      "target": ".gitignore"
    },
    {
      "name": "Husky Commit-Msg Hook",
      "source": "../$presets/husky-commit-msg",
      "target": ".husky/commit-msg"
    },
    {
      "name": "Husky Pre-Commit Hook",
      "source": "../$presets/husky-pre-commit",
      "target": ".husky/pre-commit"
    },
    {
      "name": "Knip Config",
      "source": "../$presets/knip-astro.jsonc",
      "target": "knip.jsonc"
    },
    {
      "compare": {
        "ignore": ["overrides"]
      },
      "name": "Oxfmt Config",
      "source": "../$presets/oxfmt.json",
      "target": ".oxfmtrc.json"
    },
    {
      "compare": {
        "ignore": ["overrides"]
      },
      "name": "Oxlint Config",
      "source": "../$presets/oxlint-astro.jsonc",
      "target": ".oxlintrc.jsonc"
    },
    {
      "name": "TypeScript Config",
      "source": "../$presets/tsconfig-astro.json",
      "target": "tsconfig.json"
    },
    {
      "name": "Zed Settings",
      "source": "../$presets/zed-astro.json",
      "target": ".zed/settings.json"
    },
    {
      "name": "Astro Config",
      "source": "../$presets/astro.config.mjs",
      "target": "astro.config.mjs"
    },
    {
      "name": "Wrangler Config",
      "source": "../$presets/wrangler.jsonc",
      "target": "wrangler.jsonc"
    },
    {
      "name": "CSpell Config",
      "source": "../$presets/cspell.json",
      "target": "cspell.json"
    },
    {
      "name": "HTML-Validate Config",
      "source": "../$presets/htmlvalidate.json",
      "target": ".htmlvalidate.json"
    },
    {
      "name": "Pa11y CI Config",
      "source": "../$presets/pa11yci.json",
      "target": ".pa11yci.json"
    },
    {
      "name": "Vale Config",
      "source": "../$presets/vale.ini",
      "target": ".vale.ini"
    },
    {
      "name": "Unlighthouse Config",
      "source": "../$presets/unlighthouse.config.ts",
      "target": "unlighthouse.config.ts"
    },
    {
      "compare": {
        "pinned": ["scripts", "imports", "type"]
      },
      "name": "Package JSON",
      "source": "../$presets/_package.json",
      "target": "package.json"
    }
  ],
  "js": {
    "dependencies": {},
    "devDependencies": {
      "@commitlint/cli": "21.2.4",
      "@commitlint/config-conventional": "21.2.4",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.5",
      "husky": "9.1.7",
      "knip": "6.43.0",
      "oxfmt": "0.75.0",
      "oxlint": "1.90.0",
      "rimraf": "6.1.3",
      "tsrs": "0.20.1-ts7.1.0-beta",
      "typescript": "7.0.2"
    },
    "peerDependencies": {},
    "pm": "bun"
  }
}
