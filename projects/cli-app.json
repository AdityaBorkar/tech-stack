{
	"$schema": "https://raw.githubusercontent.com/AdityaBorkar/adistack-conform/refs/heads/stable/configuration_schema/project-manifest.json",
	"@name": "CLI",
	"@description": "CLI Application using Commander",
	"file_structure": [
		{
			"name": "Source Dir",
			"target": "src/",
			"kind": "dir"
		},
		{
			"name": "AGENTS.md",
			"target": "AGENTS.md",
			"kind": "file"
		},
		{
			"name": "README.md",
			"target": "README.md",
			"kind": "file"
		}
	],
	"files": [
		{
			"name": "Bun Config",
			"source": "projects/files/bunfig/base.toml",
			"target": "bunfig.toml"
		},
		{
			"name": "Changeset Config",
			"source": "projects/files/changeset/config.json",
			"target": ".changeset/config.json"
		},
		{
			"name": "Commitlint Config",
			"source": "projects/files/commitlintrc.json",
			"target": ".commitlintrc.json"
		},
		{
			"name": "GitHub CODEOWNERS",
			"source": "projects/files/github/CODEOWNERS",
			"target": ".github/CODEOWNERS"
		},
		{
			"name": "GitHub PR Workflow",
			"source": "projects/files/github/workflows/pr.yml",
			"target": ".github/workflows/pr.yml"
		},
		{
			"name": "GitHub Publish Workflow",
			"source": "projects/files/github/workflows/publish.yml",
			"target": ".github/workflows/publish.yml"
		},
		{
			"name": "Gitignore",
			"source": "projects/files/gitignore/base.gitignore",
			"target": ".gitignore"
		},
		{
			"name": "Husky Commit-Msg Hook",
			"source": "projects/files/husky/commit-msg",
			"target": ".husky/commit-msg"
		},
		{
			"name": "Husky Pre-Commit Hook",
			"source": "projects/files/husky/pre-commit",
			"target": ".husky/pre-commit"
		},
		{
			"name": "Knip Config",
			"source": "projects/files/knip/base.json",
			"target": "knip.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxfmt Config",
			"source": "projects/files/oxfmt/base.json",
			"target": ".oxfmtrc.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxlint Config",
			"source": "projects/files/oxlint/base.json",
			"target": ".oxlintrc.json"
		},
		{
			"name": "TypeScript Config",
			"source": "projects/files/tsconfig/base.json",
			"target": "tsconfig.json"
		},
		{
			"name": "Zed Settings",
			"source": "projects/files/zed/base.json",
			"target": ".zed/settings.json"
		},
		{
			"name": "Package JSON",
			"source": "projects/files/package/cli.json",
			"target": "package.json"
		}
	]
}
