{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"sortImports": {
		"customGroups": [
			{
				"elementNamePattern": ["bun", "bun:*", "bun:*/*"],
				"groupName": "bun"
			},
			{
				"groupName": "wxt",
				"elementNamePattern": ["wxt/browser"]
			}
		],
		"groups": [
			"wxt",
			["builtin", "bun"],
			"external",
			"internal",
			["parent", "sibling", "index", "subpath"],
			["style", "side_effect_style", "side_effect"],
			"unknown"
		],
		"ignoreCase": false
	},
	"sortPackageJson": {
		"sortScripts": true
	},
	"useTabs": true
}
