{
	"bin": {
		"<binary-name>": "./.output/<binary-name>"
	},
	"description": "<one-line-description>",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		".output",
		"src",
		"package.json",
		"config",
		"README.md",
		"CHANGELOG.md",
		"skills",
		"docs/www"
	],
	"imports": {
		"#/*": "./src/*"
	},
	"keywords": ["<keyword>"],
	"homepage": "https://github.com/<owner>/<repo>#readme",
	"bugs": "https://github.com/<owner>/<repo>/issues",
	"license": "MIT",
	"author": {
		"name": "<user-name>",
		"email": "<user-email>",
		"url": "<user-website>"
	},
	"maintainers": [
		{
			"name": "<user-name>",
			"email": "<user-email>",
			"url": "<user-website>"
		}
	],
	"contributors": [
		{
			"name": "<user-name>",
			"email": "<user-email>",
			"url": "<user-website>"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/<owner>/<repo>.git"
	},
	"name": "<package-name>",
	"scripts": {
		"build": "bun scripts/build.ts",
		"check:conform": "bun dev check",
		"check:knip": "knip",
		"check:lint": "oxlint",
		"check:types": "tsrs",
		"clean": "bun rimraf --glob \"**/{node_modules,output,bun.lockb}\"",
		"dev": "bun src/index.ts",
		"format": "oxfmt",
		"prepare": "husky",
		"test": "bun test",
		"verify": "bun scripts/verify.ts"
	},
	"dependencies": {
		"@clack/prompts": "<version>",
		"commander": "<version>",
		"picocolors": "<version>",
		"zod": "<version>"
	},
	"devDependencies": {
		"@changesets/cli": "<version>",
		"@commitlint/cli": "<version>",
		"@commitlint/config-conventional": "<version>",
		"@types/bun": "<version>",
		"@types/node": "<version>",
		"husky": "<version>",
		"knip": "<version>",
		"oxfmt": "<version>",
		"oxlint": "<version>",
		"rimraf": "<version>",
		"tsrs": "<version>",
		"typescript": "<version>"
	},
	"peerDependencies": {},
	"type": "module",
	"version": "<version>"
}
