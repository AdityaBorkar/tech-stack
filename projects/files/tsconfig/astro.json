{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"#/*": ["./src/*"],
			"#assets/*": ["./assets/*"],
			"#cms/*": ["./cms/*"]
		}
	},
	"contentMappers": [
		{
			"extensions": [".astro"],
			"package": "@astrojs/ts-content-mapper"
		}
	],
	"exclude": [".output", "node_modules", ".astro", ".wrangler"],
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"]
}
