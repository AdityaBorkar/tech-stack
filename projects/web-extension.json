{
	"$schema": "https://raw.githubusercontent.com/AdityaBorkar/adistack-conform/refs/heads/main/configuration_schema/project-manifest.json",
	"description": "Web Extension using WXT",
	"file_structure": [
		{
			"name": "Source Dir",
			"target": "src/",
			"kind": "dir"
		},
		{
			"name": "Entrypoints Dir",
			"target": "entrypoints/",
			"kind": "dir"
		},
		{
			"name": "Public Dir",
			"target": "public/",
			"kind": "dir"
		},
		{
			"name": "AGENTS.md",
			"target": "AGENTS.md",
			"kind": "file"
		},
		{
			"name": "README.md",
			"target": "README.md",
			"kind": "file"
		}
	],
	"files": [
		{
			"name": "Bun Config",
			"source": "projects/files/bunfig/base.toml",
			"target": "bunfig.toml"
		},
		{
			"name": "Commitlint Config",
			"source": "projects/files/commitlintrc.json",
			"target": ".commitlintrc.json"
		},
		{
			"name": "Gitignore",
			"source": "projects/files/gitignore/webext.gitignore",
			"target": ".gitignore"
		},
		{
			"name": "Husky Commit-Msg Hook",
			"source": "projects/files/husky/commit-msg",
			"target": ".husky/commit-msg"
		},
		{
			"name": "Husky Pre-Commit Hook",
			"source": "projects/files/husky/pre-commit",
			"target": ".husky/pre-commit"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxfmt Config",
			"source": "projects/files/oxfmt/webext.json",
			"target": ".oxfmtrc.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxlint Config",
			"source": "projects/files/oxlint/webext.json",
			"target": ".oxlintrc.json"
		},
		{
			"name": "TypeScript Config",
			"source": "projects/files/tsconfig/webext.json",
			"target": "tsconfig.json"
		},
		{
			"name": "Zed Settings",
			"source": "projects/files/zed/webext.json",
			"target": ".zed/settings.json"
		},
		{
			"name": "WXT Config",
			"source": "projects/files/wxt.config.ts",
			"target": "wxt.config.ts"
		},
		{
			"compare": {
				"required": [
					"type",
					"imports",
					"exports",
					"license",
					"files",
					"scripts",
					"author",
					"maintainers",
					"contributors",
					"name",
					"version",
					"description",
					"keywords",
					"homepage",
					"bugs",
					"repository",
					"bin"
				]
			},
			"name": "Package JSON",
			"source": "projects/files/package/cli.json",
			"target": "package.json"
		}
	],
	"js": {
		"dependencies": {},
		"devDependencies": {
			"@changesets/cli": "3.0.3",
			"@commitlint/cli": "21.2.4",
			"@commitlint/config-conventional": "21.2.4",
			"@types/bun": "1.4.4",
			"husky": "9.1.7",
			"oxlint": "1.92.0",
			"typescript": "7.0.2",
			"web-ext": "10.8.0",
			"wxt": "0.21.5"
		},
		"peerDependencies": {},
		"pm": "bun"
	}
}
