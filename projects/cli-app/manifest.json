{
    "$schema": "project-manifest.json",
    "description": "CLI Application using Commander",
    "files": [
        {
            "name": "Bun Config",
            "source": "../$presets/bunfig.toml",
            "target": "bunfig.toml"
        },
        {
            "name": "CLI Structure",
            "source": "project/presets/cli-structure/STRUCTURE.md",
            "target": "docs: bun CLI app layout — flat src modules, scripts, generated schemas (adapt names)"
        },
        {
            "name": "Commitlint Config",
            "source": "../$presets/commitlint.config.json",
            "target": ".commitlintrc.json"
        },
        {
            "name": "Gitignore",
            "source": "../$presets/gitignore",
            "target": ".gitignore"
        },
        {
            "name": "Husky Commit-Msg Hook",
            "source": "../$presets/husky-commit-msg",
            "target": ".husky/commit-msg"
        },
        {
            "name": "Husky Pre-Commit Hook",
            "source": "../$presets/husky-pre-commit",
            "target": ".husky/pre-commit"
        },
        {
            "name": "Knip Config",
            "source": "../$presets/knip.json",
            "target": "knip.json"
        },
        {
            "name": "Oxfmt Config",
            "source": "../$presets/oxfmt.json",
            "target": ".oxfmtrc.json"
        },
        {
            "name": "Oxlint Config",
            "source": "../$presets/oxlint.json",
            "target": ".oxlintrc.json"
        },
        {
            "name": "Package Conventions",
            "source": "../$presets/package.json",
            "target": "docs: package.json conventions for bun CLI apps (adapt name/version/bin; keep scripts, imports, files)"
        },
        {
            "name": "TypeScript Config",
            "source": "../$presets/tsconfig.json",
            "target": "tsconfig.json"
        },
        {
            "name": "Zed Settings",
            "source": "../$presets/zed.json",
            "target": ".zed/settings.json"
        }
    ]
}
