{
	"$schema": "https://stack.adityab.tech/conform/<VERSION>/schemas/project-manifest.json",
	"description": "CLI Application using Commander",
	"file_structure": [
		{
			"name": "Source Dir",
			"target": "src/",
			"kind": "dir"
		},
		{
			"name": "AGENTS.md",
			"target": "AGENTS.md",
			"kind": "file"
		},
		{
			"name": "README.md",
			"target": "README.md",
			"kind": "file"
		}
	],
	"files": [
		{
			"name": "Bun Config",
			"source": "../$presets/bunfig.toml",
			"target": "bunfig.toml"
		},
		{
			"name": "Commitlint Config",
			"source": "../$presets/commitlintrc.json",
			"target": ".commitlintrc.json"
		},
		{
			"name": "Gitignore",
			"source": "../$presets/gitignore",
			"target": ".gitignore"
		},
		{
			"name": "Husky Commit-Msg Hook",
			"source": "../$presets/husky-commit-msg",
			"target": ".husky/commit-msg"
		},
		{
			"name": "Husky Pre-Commit Hook",
			"source": "../$presets/husky-pre-commit",
			"target": ".husky/pre-commit"
		},
		{
			"name": "Knip Config",
			"source": "../$presets/knip.json",
			"target": "knip.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxfmt Config",
			"source": "../$presets/oxfmt.json",
			"target": ".oxfmtrc.json"
		},
		{
			"compare": {
				"ignore": ["overrides"]
			},
			"name": "Oxlint Config",
			"source": "../$presets/oxlint.json",
			"target": ".oxlintrc.json"
		},
		{
			"name": "TypeScript Config",
			"source": "../$presets/tsconfig.json",
			"target": "tsconfig.json"
		},
		{
			"name": "Zed Settings",
			"source": "../$presets/zed.json",
			"target": ".zed/settings.json"
		},
		{
			"name": "Package JSON",
			"source": "../$presets/_package.json",
			"target": "package.json"
		}
	],
	"js": {
		"dependencies": {
			"@clack/prompts": "any",
			"commander": "any",
			"env-paths": "any",
			"picocolors": "any",
			"zod": "any"
		},
		"devDependencies": {
			"@commitlint/cli": "any",
			"@commitlint/config-conventional": "any",
			"@types/bun": "any",
			"@types/node": "any",
			"husky": "any",
			"knip": "any",
			"oxfmt": "any",
			"oxlint": "any",
			"rimraf": "any",
			"tsrs": "any",
			"typescript": "any"
		},
		"peerDependencies": {},
		"pm": "bun"
	},
	"github": "../$presets/github-configs/npm-package.json"
}
