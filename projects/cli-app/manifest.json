{
    "$schema": "https://stack.adityab.tech/conform/<VERSION>/schemas/project-manifest.json",
    "description": "CLI Application using Commander",
    "file_structure": [
        {
            "name": "Source Dir",
            "target": "src/",
            "kind": "dir"
        },
        {
            "name": "AGENTS.md",
            "target": "AGENTS.md",
            "kind": "file"
        },
        {
            "name": "README.md",
            "target": "README.md",
            "kind": "file"
        }
    ],
    "files": [
        {
            "name": "Bun Config",
            "source": "../$presets/bunfig.toml",
            "target": "bunfig.toml"
        },
        {
            "name": "Commitlint Config",
            "source": "../$presets/commitlintrc.json",
            "target": ".commitlintrc.json"
        },
        {
            "name": "Gitignore",
            "source": "../$presets/gitignore",
            "target": ".gitignore"
        },
        {
            "name": "Husky Commit-Msg Hook",
            "source": "../$presets/husky-commit-msg",
            "target": ".husky/commit-msg"
        },
        {
            "name": "Husky Pre-Commit Hook",
            "source": "../$presets/husky-pre-commit",
            "target": ".husky/pre-commit"
        },
        {
            "name": "Knip Config",
            "source": "../$presets/knip.json",
            "target": "knip.json"
        },
        {
            "compare": {
                "ignore": [
                    "overrides"
                ]
            },
            "name": "Oxfmt Config",
            "source": "../$presets/oxfmt.json",
            "target": ".oxfmtrc.json"
        },
        {
            "compare": {
                "ignore": [
                    "overrides"
                ]
            },
            "name": "Oxlint Config",
            "source": "../$presets/oxlint.json",
            "target": ".oxlintrc.json"
        },
        {
            "name": "TypeScript Config",
            "source": "../$presets/tsconfig.json",
            "target": "tsconfig.json"
        },
        {
            "name": "Zed Settings",
            "source": "../$presets/zed.json",
            "target": ".zed/settings.json"
        },
        {
            "compare": {
                "pinned": [
                    "scripts",
                    "imports",
                    "type"
                ]
            },
            "name": "Package JSON",
            "source": "../$presets/_package.json",
            "target": "package.json"
        }
    ],
    "js": {
        "dependencies": {
            "@clack/prompts": "1.8.1",
            "commander": "15.0.0",
            "diff": "9.0.0",
            "env-paths": "4.0.0",
            "es-toolkit": "1.53.0",
            "fs-extra": "11.4.1",
            "picocolors": "1.1.1",
            "tar": "7.5.22",
            "tinyglobby": "0.2.17",
            "untildify": "6.0.0",
            "zod": "4.6.7"
        },
        "devDependencies": {
            "@commitlint/cli": "21.2.4",
            "@commitlint/config-conventional": "21.2.4",
            "@types/bun": "1.4.4",
            "@types/fs-extra": "11.4.1",
            "@types/node": "26.6.5",
            "husky": "9.1.7",
            "knip": "6.43.0",
            "oxfmt": "0.75.0",
            "oxlint": "1.90.0",
            "rimraf": "6.1.3",
            "tsrs": "0.20.1-ts7.1.0-beta",
            "typescript": "7.0.2"
        },
        "peerDependencies": {},
        "pm": "bun"
    },
    "github": "../$presets/github-configs/npm-package.json"
}
