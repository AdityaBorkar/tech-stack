{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "#/*": ["./src/*"],
      "#assets/*": ["./assets/*"],
      "#cms/*": ["./cms/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [".output", "node_modules", ".astro", ".wrangler"],
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ]
}
