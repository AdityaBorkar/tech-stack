{
	"file_scan_exclusions": ["**/.git", "**/.output", "**/node_modules", "tsconfig.tsbuildinfo"],
	"format_on_save": "on",
	"formatter": [
		{ "code_action": "source.fixAll" },
		{ "code_action": "source.fixAll.oxc" },
		{ "language_server": { "name": "oxfmt" } }
	],
	"languages": {
		"CSS": {
			"formatter": "language_server",
			"language_servers": ["!vscode-css-language-server", "..."]
		}
	},
	"lsp": {
		"oxlint": {
			"binary": {
				"path": "bun",
				"arguments": ["./node_modules/.bin/oxlint", "--lsp"]
			},
			"initialization_options": {
				"settings": {
					"run": "onType",
					"unusedDisableDirectives": "deny"
				}
			}
		},
		"tailwindcss-language-server": {
			"binary": {
				"arguments": ["./node_modules/.bin/tailwindcss-language-server", "--stdio"],
				"path": "bun"
			}
		},
		"oxfmt": {
			"binary": {
				"path": "bun",
				"arguments": ["./node_modules/.bin/oxfmt", "--lsp"]
			},
			"initialization_options": {
				"settings": {
					"run": "onSave"
				}
			}
		},
		"typescript-ls": {
			"binary": {
				"arguments": ["./node_modules/.bin/tsrs", "--lsp", "--stdio"],
				"path": "bun"
			}
		}
	}
}
