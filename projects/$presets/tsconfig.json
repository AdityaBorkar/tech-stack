{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ES2022", "ES2023.Array"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"#/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["@types/bun"],
		"verbatimModuleSyntax": true
	},
	"include": ["**/*.ts"]
}
