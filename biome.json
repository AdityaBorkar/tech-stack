{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"preset": "all",
				"useSortedPackageJson": "off"
			}
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"overrides": [
		{
			"includes": ["**/*.ts"],
			"linter": {
				"enabled": false
			}
		},
		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": "off",
						"useSortedPackageJson": "on"
					}
				}
			},
			"includes": ["**/package.json"]
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
