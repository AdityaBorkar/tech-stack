{
	"@description": "Simplified Trunk Based Development",
	"@name": "Simplified Trunk Based Development",
	"$schema": "../node_modules/@adistack/conform/config/github-manifest.json",
	"actions": {
		"allowApprovePRs": false,
		"allowed": "all",
		"approvalForExternal": true,
		"defaultWorkflowPermissions": "read",
		"oidcImmutableSubject": true,
		"retentionDays": 90,
		"shaPinningRequired": true
	},
	"agentSuggestions": "disabled",
	"archiveSettings": {
		"commitComments": false,
		"includeLfsInArchives": false
	},
	"checks": ["lint", "format", "types", "conform"],
	"codeowners": ".github/CODEOWNERS",
	"defaultBranch": "main",
	"environments": ["production", "staging"],
	"features": {
		"discussions": false,
		"issues": true,
		"issueTemplates": false,
		"projects": false,
		"wiki": false
	},
	"merge": {
		"autoMerge": false,
		"deleteHeadBranches": true,
		"mergeCommit": false,
		"rebaseMerge": false,
		"squashMerge": true,
		"squashMessage": "pr-body",
		"squashTitle": "pr-title"
	},
	"releasesImmutable": true,
	"reviews": {
		"dismissStale": true,
		"requireCodeOwner": true,
		"requireConversationResolution": true,
		"requiredApprovals": 1,
		"requireSignedCommits": false,
		"restrictPushes": true
	},
	"rulesets": [],
	"secrets": [],
	"security": {
		"copilotAutofix": false,
		"dependabot": false,
		"dependencyAutoSubmit": true,
		"dependencyGraph": true,
		"privateVulnerabilityReporting": true,
		"pushProtection": true,
		"secretProtection": true
	},
	"signoffRequired": false,
	"socialPreview": false,
	"variables": []
}
