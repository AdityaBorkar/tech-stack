{
	"$description": "Simplified Trunk Based Development",
	"$name": "Simplified Trunk Based Development",
	"$schema": "../node_modules/@adistack/conform/config/github-manifest.json",
	"access": {
		"moderation": {
			"code_review_limits": {
				"restrict_to_explicit_access": true
			}
		}
	},
	"actions": {
		"general": {
			"allowed": "all",
			"fork_pr_approval": "all_external_contributors",
			"retention_days": 90,
			"sha_pinning_required": false,
			"workflow_permissions": {
				"can_approve_pull_requests": false,
				"default": "read"
			}
		},
		"oidc": {
			"immutable_subject": true,
			"use_default": true
		}
	},
	"advanced_security": {
		"automatic_dependency_submission": "enabled",
		"code_scanning": {
			"copilot_autofix": false
		},
		"dependabot": {
			"alerts": true,
			"security_updates": false
		},
		"dependency_graph": true,
		"private_vulnerability_reporting": {
			"enabled": true
		},
		"secret_protection": {
			"enabled": true,
			"push_protection": true
		}
	},
	"archives": {
		"include_lfs_objects": false
	},
	"codeowners": ".github/CODEOWNERS",
	"commits": {
		"comments_allowed": false,
		"signoff_required": false
	},
	"default_branch": "main",
	"environments": {
		"production": {},
		"staging": {}
	},
	"features": {
		"discussions": false,
		"issues": {
			"auto_close": true,
			"enabled": true,
			"permissions": "all-users"
		},
		"projects": false,
		"sponsorships": false,
		"wikis": {
			"enabled": false
		}
	},
	"issue_templates": false,
	"planning": {
		"agent_suggestions": "full-control"
	},
	"pull_requests": {
		"auto_merge": false,
		"delete_head_branches": true,
		"merge_commit": false,
		"merge_message": "pr-body",
		"merge_title": "pr-title",
		"permissions": "collaborators-only",
		"rebase_merge": false,
		"squash_merge": true,
		"squash_message": "pr-body",
		"squash_title": "pr-title",
		"suggest_updating_branches": false
	},
	"pushes": {
		"update_limit": null
	},
	"releases": {
		"immutable": true
	},
	"rulesets": [
		{
			"enforcement": "active",
			"include": ["~DEFAULT_BRANCH", "refs/heads/main"],
			"name": "Protect Branches",
			"rules": {
				"deletion": true,
				"pull_request": {
					"allowed_merge_methods": ["squash"],
					"dismiss_stale": true,
					"require_code_owner": true,
					"require_conversation_resolution": false,
					"require_extra_approval_for_copilot": true,
					"require_last_push_approval": false,
					"required_approvals": 0
				},
				"required_linear_history": true
			},
			"target": "branch"
		}
	],
	"secrets": {
		"actions": {
			"secrets": [],
			"variables": []
		}
	},
	"social_preview": false,
	"webhooks": []
}
